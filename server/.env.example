DASHSCOPE_API_KEY=your_dashscope_api_key
# Vision model used for scoring. DashScope retires model aliases over time;
# override this on the host if the default stops resolving.
QWEN_VL_MODEL=qwen3-vl-plus
# FFMPEG_PATH is optional. Leave unset when ffmpeg is already in PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
